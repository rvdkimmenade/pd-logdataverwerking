{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "outDir": "packages/foundation/dist",
    "rootDir": "packages/foundation/src",
    "skipLibCheck": true
  },
  "include": ["packages/foundation/src/**/*.ts"]
}
