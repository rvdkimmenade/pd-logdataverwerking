    "/api/session": {
      "post": {
        "operationId": "loginLocalDemo",
        "security": [],
        "description": "Alleen lokale demo. Willekeurige code uit het genegeerde lokale bestand; HttpOnly SameSite=Strict cookie, 30 minuten geldig. OIDC volgt in fase 6.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "code"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "maxLength": 256
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultaat",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "role",
                    "party"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "role": {
                      "enum": [
                        "editor",
                        "reviewer",
                        "reader"
                      ]
                    },
                    "party": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Resultaat",
