{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.example.invalid/consumer-failure.schema.json",
  "title":"LDV consumer failure v1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","failure_id","kind","reason","source_topic","source_partition","source_offset","payload_sha256","observed_at"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "failure_id":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "kind":{"enum":["reject","dead_letter"]},
    "reason":{"enum":["INVALID_JSON","INVALID_ENVELOPE","EVENT_ID_CONFLICT","PROCESSING_FAILED"]},
    "source_topic":{"const":"ldv.accepted.v1"},
    "source_partition":{"type":"integer","minimum":0},
    "source_offset":{"type":"string","pattern":"^(0|[1-9][0-9]*)$"},
    "payload_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "observed_at":{"type":"string","format":"date-time"},
    "original_base64":{"type":"string","minLength":4,"contentEncoding":"base64","pattern":"^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"}
  },
  "allOf":[{"if":{"properties":{"kind":{"const":"dead_letter"}}},"then":{"required":["original_base64"],"properties":{"original_base64":{},"reason":{"const":"PROCESSING_FAILED"}}},"else":{"properties":{"original_base64":false,"reason":{"enum":["INVALID_JSON","INVALID_ENVELOPE","EVENT_ID_CONFLICT"]}}}}]
}
