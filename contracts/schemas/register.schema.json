{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/register.schema.json",
  "title": "Lokaal versioned verwerkingsregister",
  "$defs": {
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "purpose",
        "legal_basis",
        "retention",
        "data_subject_categories",
        "data_categories",
        "processors",
        "recipients",
        "source_systems",
        "destination_systems"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "legal_basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "retention": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "data_subject_categories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxItems": 30,
          "uniqueItems": true,
          "minItems": 1
        },
        "data_categories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxItems": 30,
          "uniqueItems": true,
          "minItems": 1
        },
        "processors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxItems": 30,
          "uniqueItems": true
        },
        "recipients": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxItems": 30,
          "uniqueItems": true
        },
        "source_systems": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxItems": 30,
          "uniqueItems": true,
          "minItems": 1
        },
        "destination_systems": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxItems": 30,
          "uniqueItems": true
        }
      }
    },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content",
        "valid_from",
        "valid_until"
      ],
      "properties": {
        "content": {
          "$ref": "#/$defs/content"
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "create": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content",
        "valid_from",
        "valid_until",
        "party"
      ],
      "properties": {
        "content": {
          "$ref": "#/$defs/content"
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "party": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        }
      }
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content",
        "valid_from",
        "valid_until",
        "revision"
      ],
      "properties": {
        "content": {
          "$ref": "#/$defs/content"
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "publish": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activity_id",
        "version",
        "revision",
        "status",
        "content",
        "valid_from",
        "valid_until"
      ],
      "properties": {
        "activity_id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "draft",
            "published"
          ]
        },
        "content": {
          "$ref": "#/$defs/content"
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "detail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "processing_activity_id",
        "party",
        "versions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "processing_activity_id": {
          "type": "string",
          "format": "uri"
        },
        "party": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "versions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/version"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "processing_activity_id",
        "party",
        "name",
        "version_count",
        "draft_count"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "processing_activity_id": {
          "type": "string",
          "format": "uri"
        },
        "party": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version_count": {
          "type": "integer"
        },
        "draft_count": {
          "type": "integer"
        }
      }
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string"
        }
      }
    }
  }
}
