{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/query.schema.json",
  "$defs": {
    "search": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "event_id": {"type":"string","format":"uuid"},
        "trace_id": {"type":"string","pattern":"^[0-9a-f]{32}$"},
        "span_id": {"type":"string","pattern":"^[0-9a-f]{16}$"},
        "from": {"type":"integer","minimum":0,"maximum":9007199254740991},
        "until": {"type":"integer","minimum":0,"maximum":9007199254740991},
        "source_application": {"type":"string","minLength":1,"maxLength":200},
        "processing_activity_id": {"type":"string","format":"uri","maxLength":2048},
        "subject_id": {"type":"string","minLength":1,"maxLength":512},
        "limit": {"type":"integer","minimum":1,"maximum":100},
        "cursor": {"type":"string","minLength":1,"maxLength":4096}
      }
    },
    "item": {
      "type":"object","additionalProperties":false,
      "required":["event_id","envelope","original_base64","sha256","stored_at","processing_activity"],
      "properties": {
        "event_id":{"type":"string","format":"uuid"},
        "envelope":{"$ref":"ldv-envelope.schema.json"},
        "original_base64":{"type":"string","minLength":1},
        "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "stored_at":{"type":"string","format":"date-time"},
        "processing_activity": {
          "oneOf":[
            {"type":"object","additionalProperties":false,"required":["status"],"properties":{"status":{"enum":["not_found","unsupported_id"]}}},
            {"type":"object","additionalProperties":false,"required":["status","version","valid_from","valid_until","content"],"properties":{
              "status":{"const":"resolved"},"version":{"type":"integer","minimum":1},
              "valid_from":{"type":"string","format":"date-time"},"valid_until":{"type":["string","null"],"format":"date-time"},
              "content":{"$ref":"register.schema.json#/$defs/content"}
            }}
          ]
        }
      }
    },
    "page": {
      "type":"object","additionalProperties":false,"required":["items","next_cursor"],
      "properties":{"items":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/item"}},"next_cursor":{"type":["string","null"]}}
    }
  }
}
